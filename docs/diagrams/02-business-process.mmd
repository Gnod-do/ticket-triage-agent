%% Бизнес-процесс: агент работает параллельно поддержке и не добавляет ей работы
flowchart TB
  classDef human fill:#FFFFFF,stroke:#8A98A8,color:#10314C,stroke-width:1.5px
  classDef ai fill:#DDF3F2,stroke:#00918F,color:#0B3F3E,stroke-width:1.5px
  classDef det fill:#E6EEF5,stroke:#10314C,color:#10314C,stroke-width:1.5px
  classDef dec fill:#FFF6EE,stroke:#F56A2B,color:#5A2A10,stroke-width:1.5px

  subgraph R1["1 · Поддержка — как сейчас, без изменений"]
    direction LR
    U["Пользователь"]:::human --> CH{"Канал"}:::dec
    CH -->|"звонок"| T["Обращение<br/>в системе"]:::det
    CH -->|"единое окно + файл"| T
    T --> S["Менеджер решает<br/>по действующему SLA"]:::human
  end

  subgraph R2["2 · Агент — параллельно, только чтение копии обращений"]
    direction LR
    AG["Классификация<br/>и группировка"]:::ai --> SP{"Всплеск<br/>за час?"}:::dec
    SP -->|"да"| AL["Старшему<br/>смены"]:::human
    SP -->|"нет"| TH{"Тема ≥ 5<br/>обращений?"}:::dec
    TH -->|"да"| SR{"Сервисные<br/>запросы?"}:::dec
    SR -->|"да"| X["Отклонить"]:::det
    SR -->|"нет"| BL{"Задача уже<br/>в бэклоге?"}:::dec
    BL -->|"да"| CM["Комментарий<br/>+N обращений"]:::ai
    BL -->|"нет"| DG["Элемент<br/>дайджеста"]:::ai
  end

  subgraph R3["3 · Продуктовая команда и эффект"]
    direction LR
    PO{"Решение<br/>команды"}:::dec -->|"accepted"| BK["Задача →<br/>исправление"]:::human
    BK --> R["Меньше повторных<br/>обращений"]:::human
    PO -->|"rejected /<br/>needs_info"| FB["Обратная связь<br/>агенту"]:::det
    R --> M["Метрики M1–M4<br/>на дашборде"]:::det
    FB --> M
  end

  R1 -.->|"копия обращения, раз в 15–60 мин"| R2
  R2 -->|"еженедельный дайджест"| R3
  style R1 fill:#FBFCFD,stroke:#B8C4D0,stroke-width:1.2px
  style R2 fill:#FBFCFD,stroke:#00918F,stroke-width:1.2px
  style R3 fill:#FBFCFD,stroke:#10314C,stroke-width:1.2px
