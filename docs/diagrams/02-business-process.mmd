%% Бизнес-процесс: агент работает параллельно поддержке и не добавляет ей работы
flowchart TB
  classDef human fill:#e7f7ec,stroke:#3a9b5c,color:#1f4d30
  classDef ai fill:#f2ebff,stroke:#7151a9,color:#2b1f48
  classDef det fill:#eaf4ff,stroke:#3d76a2,color:#1e3554
  classDef dec fill:#fff2d9,stroke:#a66b17,color:#4d3210

  U["Пользователь продукта"]:::human --> CH{"Канал"}:::dec
  CH -->|"звонок (запись)"| T["Обращение в системе"]:::det
  CH -->|"единое окно (+ файл / картинка)"| T
  T --> S["Менеджер поддержки решает обращение<br/>по действующему SLA — без изменений"]:::human
  T -.->|"копия для анализа, read-only"| AG["Агент: классификация и<br/>группировка похожих обращений"]:::ai

  AG --> SP{"Всплеск за час?"}:::dec
  SP -->|"да"| AL["Предупреждение старшему смены"]:::human
  SP -->|"нет"| TH{"Тема набрала ≥ 5 обращений?"}:::dec
  TH -->|"нет"| W["Ждать новых обращений"]:::det
  TH -->|"да"| SR{"Это сервисные запросы,<br/>а не проблема продукта?"}:::dec
  SR -->|"да"| X["Отклонить — команду не беспокоить"]:::det
  SR -->|"нет"| BL{"Уже есть задача в бэклоге?"}:::dec
  BL -->|"да"| CM["Комментарий в задаче:<br/>+N новых обращений"]:::ai
  BL -->|"нет"| DG["Элемент еженедельного дайджеста<br/>с числами и ссылками на обращения"]:::ai

  DG --> PO{"Решение продуктовой команды"}:::dec
  PO -->|"accepted"| BK["Задача в бэклоге → исправление"]:::human
  PO -->|"rejected / needs_info"| FB["Обратная связь агенту"]:::det
  BK --> R["Меньше повторных обращений по теме"]:::human
  FB --> M["Метрики M1–M4 на дашборде"]:::det
  R --> M
  CM --> M
