%% Алгоритм агента по одному кластеру: 4 возможных исхода, ≤ 8 вызовов инструментов
flowchart TB
  classDef tool fill:#E6EEF5,stroke:#10314C,color:#10314C,stroke-width:1.5px
  classDef dec fill:#FFF6EE,stroke:#F56A2B,color:#5A2A10,stroke-width:1.5px
  classDef out fill:#DDF3F2,stroke:#00918F,color:#0B3F3E,stroke-width:1.5px
  classDef gate fill:#FDEBE1,stroke:#F56A2B,color:#5A2A10,stroke-width:1.5px

  subgraph A1["Шаг 1 · Сбор фактов"]
    direction LR
    S(["cluster_id"]) --> T1["get_cluster_stats<br/>N, M, тренд"]:::tool
    T1 --> T2["get_cluster_examples<br/>E1..E8 без ПДн"]:::tool
    T2 --> T3["get_cluster_history"]:::tool
    T3 --> D1{"Сервисные, несвязанные<br/>или уже отклонено?"}:::dec
    D1 -->|"да"| L1["label_cluster"]:::out
  end

  subgraph A2["Шаг 2 · Не дублировать и найти адресата"]
    direction LR
    T4["search_backlog"]:::tool --> D3{"Задача<br/>найдена?"}:::dec
    D3 -->|"да"| L2["update_backlog_item<br/>только комментарий"]:::out
    D3 -->|"нет"| T5["get_product_owner"]:::tool
    T5 --> D4{"Владелец<br/>известен?"}:::dec
    D4 -->|"нет"| L4a["request_human_review"]:::out
  end

  subgraph A3["Шаг 3 · Отправка через политику"]
    direction LR
    T6["submit_digest_item"]:::tool --> G{{"PolicyGate<br/>числа · ссылки · ПДн · канал"}}:::gate
    G -->|"OK"| L3["Дайджест → outbox"]:::out
    G -->|"нарушение"| D5{"Первая<br/>попытка?"}:::dec
    D5 -->|"да: исправить"| T6
    D5 -->|"нет"| L4b["request_human_review"]:::out
  end

  A1 -->|"нет: проблема продукта"| A2
  A2 -->|"владелец известен"| A3
  B["Любой шаг: бюджет 8 вызовов превышен → request_human_review"]:::gate
  A3 ~~~ B
  style A1 fill:#FBFCFD,stroke:#10314C,stroke-width:1.2px
  style A2 fill:#FBFCFD,stroke:#F56A2B,stroke-width:1.2px
  style A3 fill:#FBFCFD,stroke:#00918F,stroke-width:1.2px
