{
  "theme": "base",
  "fontFamily": "Arial, Helvetica, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "17px",
    "primaryColor": "#E6EEF5",
    "primaryBorderColor": "#10314C",
    "primaryTextColor": "#10314C",
    "secondaryColor": "#DDF3F2",
    "secondaryBorderColor": "#00918F",
    "tertiaryColor": "#F7F9FB",
    "tertiaryBorderColor": "#B8C4D0",
    "lineColor": "#5A6775",
    "textColor": "#10314C",
    "edgeLabelBackground": "#FFFFFF",
    "clusterBkg": "#FBFCFD",
    "clusterBorder": "#B8C4D0",
    "titleColor": "#10314C",
    "actorBkg": "#E6EEF5",
    "actorBorder": "#10314C",
    "actorTextColor": "#10314C",
    "actorLineColor": "#B8C4D0",
    "signalColor": "#10314C",
    "signalTextColor": "#10314C",
    "labelBoxBkgColor": "#FDEBE1",
    "labelBoxBorderColor": "#F56A2B",
    "labelTextColor": "#5A2A10",
    "loopTextColor": "#5A2A10",
    "noteBkgColor": "#FFF6EE",
    "noteBorderColor": "#F56A2B",
    "noteTextColor": "#10314C",
    "activationBkgColor": "#DDF3F2",
    "activationBorderColor": "#00918F",
    "sequenceNumberColor": "#FFFFFF"
  },
  "flowchart": {
    "nodeSpacing": 40,
    "rankSpacing": 50,
    "padding": 12,
    "curve": "basis",
    "htmlLabels": true,
    "wrappingWidth": 280
  },
  "sequence": {
    "actorMargin": 34,
    "messageMargin": 42,
    "mirrorActors": false,
    "boxMargin": 8,
    "noteMargin": 8,
    "width": 190,
    "height": 52
  }
}