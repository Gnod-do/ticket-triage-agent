%% Архитектура: 5 логических сервисов, 3 развёртываемых процесса, всё внутри корпоративного контура
flowchart TB
  classDef src fill:#eef1f5,stroke:#55637a,color:#1e2733
  classDef det fill:#eaf4ff,stroke:#3d76a2,color:#1e3554
  classDef ai fill:#f2ebff,stroke:#7151a9,color:#2b1f48
  classDef gate fill:#fff2d9,stroke:#a66b17,color:#4d3210
  classDef human fill:#e7f7ec,stroke:#3a9b5c,color:#1f4d30

  subgraph CORP["🔒 Корпоративный контур — внешние LLM и API не используются"]
    direction TB
    SRC[("Система обработки обращений<br/>тикеты · записи звонков · вложения<br/>хранение 1 год")]:::src

    subgraph P1["Процесс 1 · ingest-worker"]
      I["① Ingest<br/>курсор по updated_at · дедупликация<br/>маскирование ПДн · product_id"]:::det
    end

    subgraph P2["Процесс 2 · model-workers (GPU, очереди)"]
      M["② Media<br/>Qwen-ASR — звонки<br/>Qwen-VL — изображения"]:::ai
      E["③ Enrich<br/>Qwen 3.8 → JSON: тип, функция, суть<br/>+ эмбеддинг"]:::ai
    end

    subgraph P3["Процесс 3 · приложение"]
      C["④ Cluster & Aggregate<br/>HDBSCAN по продукту · счётчики · тренды<br/>правило всплеска"]:::det
      A["⑤ Agent-digest<br/>Qwen 3.8 + 10 инструментов<br/>≤ 8 вызовов на кластер"]:::ai
      G{{"PolicyGate<br/>≥5 ссылок · числа из статистики<br/>нет ПДн · канал из allowlist"}}:::gate
      O["Outbox<br/>идемпотентная доставка"]:::det
    end

    DB[("PostgreSQL + pgvector<br/>сигналы · кластеры · аудит")]:::src
    REG[("Справочник продукт → команда<br/>бэклог / трекер")]:::src
  end

  SUP["👩‍💻 Поддержка<br/>работает по действующему SLA"]:::human
  LEAD["🚨 Старший смены"]:::human
  PT["📥 Продуктовые команды"]:::human
  BI["📊 Дашборд метрик"]:::human

  SRC -->|"обращение сразу, как сейчас"| SUP
  SRC -->|"read-only, каждые 15–60 мин"| I
  I -->|"аудио / изображения"| M
  I -->|"текст без ПДн"| E
  M -->|"расшифровка / описание"| E
  E --> DB
  DB --> C
  C -->|"≥ 5 обращений за час и ≥ 3× фона"| LEAD
  C -->|"кластеры ≥ 5 обращений, еженедельно"| A
  A <-->|"чтение"| REG
  A --> G
  G -->|"прошло"| O
  G -.->|"нарушение → исправить или эксперту"| A
  O -->|"дайджест"| PT
  PT -->|"accepted / rejected / needs_info"| DB
  DB --> BI
  style CORP fill:#fbfcfe,stroke:#9aa7b8
  style P1 fill:#f5f9ff,stroke:#3d76a2
  style P2 fill:#faf7ff,stroke:#7151a9
  style P3 fill:#f5f9ff,stroke:#3d76a2
